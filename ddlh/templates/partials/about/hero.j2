<section class="about-hero">
    <div class="about-hero-inner">
        {% include "partials/breadcrumbs.j2" %}
        <div class="about-hero-grid">
            <h1 class="about-hero-title">About</h1>
        </div>
    </div>
    <figure class="about-hero-image">
        {% set img = "images/about/about-" %}
        <picture>
            <source type="image/webp"
                    srcset="{{ url_for('static', filename=img ~ '800.webp') }} 800w, {{ url_for('static', filename=img ~ '1200.webp') }} 1200w, {{ url_for('static', filename=img ~ '1600.webp') }} 1600w"
                    sizes="100vw">
            <img src="{{ url_for('static', filename=img ~ '1600.jpg') }}"
                 srcset="{{ url_for('static', filename=img ~ '800.jpg') }} 800w, {{ url_for('static', filename=img ~ '1200.jpg') }} 1200w, {{ url_for('static', filename=img ~ '1600.jpg') }} 1600w"
                 sizes="100vw"
                 alt="The Fab Lab Barcelona and make-a-thek team"
                 width="1600"
                 height="1067"
                 fetchpriority="high"
                 decoding="async">
        </picture>
    </figure>
</section>
