<li class="theme-resources-item" data-type="{{ document.format }}">
    <button type="button"
            class="theme-resources-header"
            aria-expanded="false"
            aria-controls="resource-{{ document.id }}">
        <span class="theme-resources-heading">
            <span class="theme-resources-format theme-resources-format-{{ document.format_type }}">{{ document.format }}</span>
            <span class="theme-resources-title">{{ document.title }}</span>
        </span>
        {% if document.author %}
            <span class="theme-resources-author">
                <span class="theme-resources-author-label">From</span>
                {{ document.author }}
            </span>
        {% endif %}
        <span class="theme-resources-toggle" aria-hidden="true"></span>
    </button>
    <div class="theme-resources-panel" id="resource-{{ document.id }}">
        <div class="theme-resources-panel-inner">
            <div class="theme-resources-body {% if document.image_url %}theme-resources-body-image{% endif %}">
                <div class="theme-resources-content">
                    {% if document.description %}
                        <div class="theme-resources-description">
                            {% markdown %}
                            {{ document.description }}
                        {% endmarkdown %}
                    </div>
                {% endif %}
                {% if document.tags %}
                    <ul class="theme-resources-tags">
                        {% for tag in document.tags %}
                            <li>
                                <a class="theme-resources-tag" href="{{ url_for('tag', tag=tag) }}">{{ tag }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <div class="theme-resources-actions">
                    <a class="theme-resources-access"
                       href="{{ document.link }}"
                       target="_blank"
                       rel="noopener">
                        Go to document
                        <svg aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M3.73806 1.04998L5.19406 -1.81198e-05C5.64206 0.737315 6.08072 1.39065 6.51006 1.95998C6.93939 2.52931 7.38272 3.03798 7.84006 3.48598C8.30672 3.93398 8.80139 4.34931 9.32406 4.73198V4.81598C8.80139 5.18931 8.30672 5.60465 7.84006 6.06198C7.38272 6.50998 6.93939 7.01865 6.51006 7.58798C6.08072 8.14798 5.64206 8.79665 5.19406 9.53398L3.73806 8.49798C4.13006 7.89132 4.53606 7.36398 4.95606 6.91598C5.37606 6.45865 5.79606 6.06665 6.21606 5.73998C6.63606 5.41331 7.04672 5.15198 7.44806 4.95598C7.84939 4.75998 8.22739 4.61998 8.58206 4.53598V5.01198C8.22739 4.92798 7.84939 4.78798 7.44806 4.59198C7.04672 4.38665 6.63606 4.12065 6.21606 3.79398C5.79606 3.46731 5.37606 3.07998 4.95606 2.63198C4.53606 2.17465 4.13006 1.64732 3.73806 1.04998ZM5.6684e-05 3.80798H3.90606C4.60606 3.80798 5.25472 3.84065 5.85206 3.90598C6.44939 3.97132 6.99539 4.05532 7.49006 4.15798L8.54006 4.77398L7.49006 5.37598C6.99539 5.47865 6.44939 5.56265 5.85206 5.62798C5.25472 5.69331 4.60606 5.72598 3.90606 5.72598H5.6684e-05V3.80798Z" fill="#2E0E70"/>
                        </svg>
                    </a>
                    <button type="button"
                            class="theme-resources-access theme-resources-share"
                            data-share-url="{{ url_for('document', document_id=document.id, _external=True) }}">
                        Share resource
                        <svg aria-hidden="true" width="18" height="11" viewBox="0 0 18 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4.65146 3.57832L4.93855 1.80631C5.7767 2.0109 6.54886 2.16269 7.25503 2.26169C7.96119 2.36068 8.63436 2.40688 9.27452 2.40028C9.92129 2.38708 10.5648 2.33098 11.2049 2.23199L11.2643 2.29138C11.1587 2.92495 11.1026 3.56842 11.096 4.22179C11.0894 4.86195 11.1356 5.53512 11.2346 6.24128C11.327 6.94085 11.4755 7.70971 11.6801 8.54786L9.91799 8.84485C9.7662 8.13869 9.6804 7.47872 9.6606 6.86495C9.63421 6.24458 9.654 5.67041 9.72 5.14244C9.786 4.61446 9.89159 4.13929 10.0368 3.71691C10.182 3.29453 10.3503 2.92825 10.5417 2.61807L10.8782 2.95465C10.5681 3.14604 10.2018 3.31433 9.7794 3.45952C9.35042 3.59812 8.87194 3.70041 8.34397 3.76641C7.816 3.8324 7.24513 3.8555 6.63136 3.83571C6.01099 3.80931 5.35102 3.72351 4.65146 3.57832ZM3.95849 8.17168L6.72045 5.40972C7.21543 4.91475 7.6972 4.47917 8.16578 4.10299C8.63436 3.72681 9.07983 3.40013 9.50221 3.12294L10.6803 2.81606L10.3635 3.9842C10.0863 4.40658 9.7596 4.85205 9.38342 5.32063C9.00724 5.7892 8.57166 6.27098 8.07668 6.76596L5.31473 9.52791L3.95849 8.17168Z" fill="#2E0E70"/>
                        </svg>
                    </button>
                </div>
            </div>
            {% if document.image_url %}
                <img class="theme-resources-image"
                     src="{{ document.image_url }}"
                     alt=""
                     loading="lazy">
            {% endif %}
        </div>
    </div>
</div>
</li>
