{% set resource_types = documents|map(attribute="format")|select|unique|sort %}
<section class="theme-resources">
    <div class="theme-resources-inner">
        <aside class="theme-resources-filters">
            <div class="theme-resources-filters-header">
                <p class="theme-resources-label">Resources</p>
                <button type="button" class="theme-resources-all">All</button>
            </div>
            <ul class="theme-resources-types">
                {% for type in resource_types %}
                    <li>
                        <button type="button"
                                class="theme-resources-type"
                                data-filter="{{ type }}"
                                aria-pressed="false">
                            <span class="theme-resources-type-name">{{ type }}</span>
                            <span class="theme-resources-clear" aria-hidden="true">×</span>
                        </button>
                    </li>
                {% endfor %}
            </ul>
        </aside>
        <ul class="theme-resources-list">
            {% for document in documents %}
                {% include "partials/theme/resourceItem.j2" %}
            {% endfor %}
        </ul>
    </div>
</section>
<script>
  (() => {
    const section = document.currentScript.previousElementSibling;
    const buttons = section.querySelectorAll(".theme-resources-type");
    const items = section.querySelectorAll(".theme-resources-item");
    const headers = section.querySelectorAll(".theme-resources-header");

    // Filters
    const setFilter = (filter) => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.filter === filter)));
      items.forEach((item) => {
        item.hidden = filter !== null && item.dataset.type !== filter;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        // Clicking the selected type (its X) clears the filter
        setFilter(button.getAttribute("aria-pressed") === "true" ? null : button.dataset.filter);
      });
    });
    section.querySelector(".theme-resources-all").addEventListener("click", () => setFilter(null));

    // Accordion: one resource open at a time
    headers.forEach((header) => {
      header.addEventListener("click", () => {
        const open = header.getAttribute("aria-expanded") !== "true";
        headers.forEach((h) => h.setAttribute("aria-expanded", String(h === header && open)));
      });
    });
  })();
</script>
